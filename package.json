{
  "name": "misgastosapp",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo de MisGastos.app: worker (WhatsApp/email/API) y app mobile",
  "license": "MIT",
  "author": "davidvargas.d45@gmail.com",
  "scripts": {
    "check": "pnpm --filter @misgastos/worker check",
    "deploy": "pnpm --filter @misgastos/worker deploy",
    "dev": "pnpm --filter @misgastos/worker dev",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "mobile:start": "pnpm --filter @misgastos/mobile start",
    "tail": "pnpm --filter @misgastos/worker tail",
    "test": "pnpm --filter @misgastos/worker test"
  },
  "devDependencies": {
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0"
  }
}
